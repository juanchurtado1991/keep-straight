    <string name="wizard_welcome_title">Bienvenido a KeepStraight</string>
    <string name="wizard_welcome_body">Este equipo vigila tu postura con la webcam. Todo funciona sin conexión aquí.</string>
    <string name="wizard_welcome_companion">Teléfono y reloj son complementos opcionales para alertas en la muñeca e historial en el teléfono.</string>
    <string name="wizard_phone_watch_title">Teléfono y reloj</string>
    <string name="wizard_hub_intro">Complementos opcionales — elige cualquier paso u omítelos todos. Orden sugerido: reloj, teléfono y enlace.</string>
    <string name="wizard_hub_link_paired">Enlace con teléfono: conectado</string>
    <string name="wizard_hub_link_degraded">Enlace con teléfono: necesita reconexión</string>
    <string name="wizard_hub_link_failed">Enlace con teléfono: caducado — escanea un QR nuevo</string>
    <string name="wizard_hub_link_not_setup">Enlace con teléfono: sin configurar</string>
    <string name="wizard_hub_body_paired">El historial y las alertas del reloj pasan por el teléfono. Aún puedes reinstalar apps abajo.</string>
    <string name="wizard_hub_body_not_setup">Instala la app del reloj antes que la del teléfono para que el teléfono la vea. El enlace solo hace falta para historial y alertas en la muñeca — el escritorio funciona solo.</string>
    <string name="wizard_hub_body_else">Usa «Vincular teléfono» para un QR nuevo, o reconecta desde Inicio si el token sigue válido.</string>
    <string name="wizard_step_install_watch">1. Instalar app del reloj</string>
    <string name="wizard_step_install_phone">2. Instalar app del teléfono</string>
    <string name="wizard_step_link_phone">3. Vincular teléfono al escritorio</string>
    <string name="wizard_link_title">Vincular teléfono al escritorio</string>
    <string name="wizard_link_body">Solo es el enlace KeepStraight (no ADB). Abre la app del teléfono → escanea este código. Misma Wi‑Fi.</string>
    <string name="wizard_link_need_phone_title">¿Necesitas la app del teléfono primero?</string>
    <string name="wizard_link_need_phone_body">Si KeepStraight aún no está en el teléfono, vuelve atrás y elige Instalar app del teléfono. Vincular no instala nada.</string>
    <string name="wizard_link_waiting">Esperando tu teléfono…</string>
    <string name="wizard_link_qr_error_title">No se pudo mostrar un QR</string>
    <string name="wizard_link_qr_error_body">Inténtalo de nuevo. Comprueba que nada más use el puerto de emparejamiento.</string>
    <string name="wizard_link_qr_cd">QR para vincular teléfono KeepStraight</string>
    <string name="wizard_install_phone_title">Instalar en tu teléfono</string>
    <string name="wizard_install_phone_body">Sin cables. Tu teléfono y este equipo deben estar en la misma Wi‑Fi.</string>
    <string name="wizard_install_phone_on_phone_title">En tu teléfono</string>
    <string name="wizard_install_phone_on_phone_body">Ajustes → Opciones de desarrollador → Depuración inalámbrica → Vincular dispositivo con código QR. Luego apunta el teléfono al código de abajo.</string>
    <string name="wizard_install_phone_qr_cd">Código QR para instalar KeepStraight en tu teléfono</string>
    <string name="wizard_install_phone_skip">Omitir — ya instalada, o más tarde</string>
    <string name="wizard_install_phone_settings_hint">Puedes instalar la app del teléfono en cualquier momento desde Ajustes.</string>
    <string name="wizard_install_watch_title">Instalar en tu reloj</string>
    <string name="wizard_install_watch_body">Solo instala la app del reloj. No vincula tu teléfono y el teléfono no tiene que intervenir.</string>
    <string name="wizard_install_watch_on_watch_title">En el reloj</string>
    <string name="wizard_install_watch_on_watch_body">Ajustes → Opciones de desarrollador → Depuración inalámbrica activada, misma Wi‑Fi que este equipo. Si el reloj ya está conectado aquí, pulsa Instalar. Si no, abre Vincular dispositivo nuevo e introduce la dirección/código abajo.</string>
    <string name="wizard_install_watch_address_label">Dirección del reloj (IP:puerto)</string>
    <string name="wizard_install_watch_address_placeholder">192.168.1.42:37031</string>
    <string name="wizard_install_watch_code_label">Código de emparejamiento (déjalo vacío si no hay)</string>
    <string name="wizard_install_watch_code_placeholder">123456</string>
    <string name="wizard_install_watch_pairing_note">Es emparejamiento de depuración inalámbrica del reloj — no el QR KeepStraight del teléfono.</string>
    <string name="wizard_install_on_device">Instalar en %1$s</string>

