    <string name="msg_adb_connect_invalid_body">Use the IP and port shown at the top of Wireless debugging (e.g. 192.168.1.20:41234).</string>
    <string name="msg_adb_connect_timeout_title">Connect timed out</string>
    <string name="msg_adb_connect_timeout_body">Same Wi‑Fi? Leave Wireless debugging on, then retry Connect.</string>
    <string name="msg_adb_connect_failed_title">Couldn’t connect</string>
    <string name="msg_adb_connect_failed_body">If this is the first time, pair with the 6‑digit code first, then connect with the IP:port from Wireless debugging.</string>
    <string name="msg_adb_scan_timeout_title">Device scan timed out</string>
    <string name="msg_adb_scan_timeout_body">ADB didn’t respond. Toggle Wireless debugging off/on and try again.</string>
    <string name="msg_adb_no_device_title">No wireless device</string>
    <string name="msg_adb_no_device_body">Pair and connect with Wireless debugging first (same Wi‑Fi). Then install.</string>
    <string name="msg_adb_unauthorized_title">Authorize this computer</string>
    <string name="msg_adb_unauthorized_body">On the phone/watch, allow the debugging prompt, then retry.</string>
    <string name="msg_adb_offline_title">Device offline</string>
    <string name="msg_adb_offline_body">Reconnect wireless debugging (Connect again), keep the screen on, and retry.</string>
    <string name="msg_adb_phone_not_ready_title">The phone isn’t ready</string>
    <string name="msg_adb_phone_not_ready_body">Keep the phone unlocked with Wireless debugging open, then try again.</string>
    <string name="msg_adb_watch_not_ready_title">The watch isn’t ready</string>
    <string name="msg_adb_watch_not_ready_body">Keep the watch awake with Wireless debugging open on the same Wi‑Fi, then try again.</string>
    <string name="msg_adb_install_timeout_title">Install timed out</string>
    <string name="msg_adb_install_timeout_body">Stay on the same Wi‑Fi with Wireless debugging open, then retry.</string>
    <string name="msg_adb_install_failed_title">Install failed</string>
    <string name="msg_adb_install_failed_body">Couldn’t install KeepStraight on the phone. Check free storage and that Wireless debugging stays open.</string>
    <string name="msg_adb_install_failed_watch_body">Couldn’t install KeepStraight on the watch. Check free storage and that Wireless debugging stays open.</string>
    <string name="msg_adb_uninstall_retry_timeout_title">Install timed out</string>
    <string name="msg_adb_uninstall_retry_timeout_body">Removed the old app, but the new install timed out. Try again.</string>
    <string name="msg_adb_phone_apk_missing_title">Phone app package missing</string>
    <string name="msg_adb_phone_apk_missing_body">This desktop build doesn’t include the Android APK yet. Package KeepStraight with keepstraight-phone.apk, then retry.</string>
    <string name="msg_adb_wear_apk_missing_title">Watch app package missing</string>
    <string name="msg_adb_wear_apk_missing_body">Wear APK isn’t bundled. Connect the watch over wireless debugging (or install from the phone) and retry when the package is available.</string>
    <string name="msg_adb_qr_waiting">Waiting for you to scan the QR on your phone…</string>
    <string name="msg_adb_qr_phone_found">Phone found — pairing…</string>
    <string name="msg_adb_qr_connected">Connected. Ready to install.</string>
    <string name="msg_adb_qr_waiting_phone_title">Still waiting for your phone</string>
    <string name="msg_adb_qr_waiting_phone_body">On the phone: Settings → Developer options → Wireless debugging → Pair device with QR code. Then scan the code on this screen.</string>
    <string name="msg_adb_qr_connect_failed_title">Almost there — couldn't finish connecting</string>
    <string name="msg_adb_qr_connect_failed_body">The phone paired but the connection dropped. Tap Show a new code and scan again.</string>
    <string name="msg_adb_qr_browse_failed_title">Couldn't look for your phone on Wi‑Fi</string>
    <string name="msg_adb_qr_browse_failed_body">Check that the phone and this computer are on the same network, then try again.</string>
    <string name="msg_adb_qr_watch_pair_title">Watch pairing failed</string>
    <string name="msg_adb_qr_watch_pair_body">Check the code and address on the watch, then try Connect &amp; install again.</string>
