    <!-- Wizard -->
    <string name="wizard_welcome_title">Welcome to KeepStraight</string>
    <string name="wizard_welcome_body">This computer watches your posture with the webcam. Everything runs offline here.</string>
    <string name="wizard_welcome_companion">Phone and watch are optional add-ons for alerts on your wrist and history on your phone.</string>
    <string name="wizard_phone_watch_title">Phone &amp; watch</string>
    <string name="wizard_hub_intro">Optional add-ons — pick any step, or skip them all. Suggested order: watch first, then phone, then link.</string>
    <string name="wizard_hub_link_paired">Phone link: connected</string>
    <string name="wizard_hub_link_degraded">Phone link: needs reconnect</string>
    <string name="wizard_hub_link_failed">Phone link: expired — scan a new QR</string>
    <string name="wizard_hub_link_not_setup">Phone link: not set up</string>
    <string name="wizard_hub_body_paired">History and watch alerts go through the phone. You can still reinstall apps below.</string>
    <string name="wizard_hub_body_not_setup">Install the watch app before the phone so the phone can see it. Linking is only needed for history and wrist alerts — desktop works alone.</string>
    <string name="wizard_hub_body_else">Use “Link phone” for a fresh QR, or reconnect from Home if the token is still valid.</string>
    <string name="wizard_step_install_watch">1. Install watch app</string>
    <string name="wizard_step_install_phone">2. Install phone app</string>
    <string name="wizard_step_link_phone">3. Link phone to desktop</string>
    <string name="wizard_link_title">Link phone to desktop</string>
    <string name="wizard_link_body">This is only the KeepStraight link (not ADB). Open the phone app → scan this code. Same Wi‑Fi.</string>
    <string name="wizard_link_need_phone_title">Need the phone app first?</string>
    <string name="wizard_link_need_phone_body">If KeepStraight isn’t on the phone yet, go back and choose Install phone app. Linking doesn’t install anything.</string>
    <string name="wizard_link_waiting">Waiting for your phone…</string>
    <string name="wizard_link_qr_error_title">Couldn’t show a QR</string>
    <string name="wizard_link_qr_error_body">Try again. Check that nothing else is using the pairing port.</string>
    <string name="wizard_link_qr_cd">QR to link KeepStraight phone</string>
    <string name="wizard_install_phone_title">Install on your phone</string>
    <string name="wizard_install_phone_body">No cables. Your phone and this computer need the same Wi‑Fi.</string>
    <string name="wizard_install_phone_on_phone_title">On your phone</string>
    <string name="wizard_install_phone_on_phone_body">Settings → Developer options → Wireless debugging → Pair device with QR code. Then point the phone at the code below.</string>
    <string name="wizard_install_phone_qr_cd">QR code to install KeepStraight on your phone</string>
    <string name="wizard_install_phone_skip">Skip — already installed, or later</string>
    <string name="wizard_install_phone_settings_hint">You can install the phone app anytime from Settings.</string>
    <string name="wizard_install_watch_title">Install on your watch</string>
    <string name="wizard_install_watch_body">This only installs the watch app. It does not link your phone, and your phone doesn’t need to be involved.</string>
    <string name="wizard_install_watch_on_watch_title">On the watch</string>
    <string name="wizard_install_watch_on_watch_body">Settings → Developer options → Wireless debugging on, same Wi‑Fi as this computer. If the watch is already connected here, just tap Install. Otherwise open Pair new device and enter the address/code below.</string>
    <string name="wizard_install_watch_address_label">Watch address (IP:port)</string>
    <string name="wizard_install_watch_address_placeholder">192.168.1.42:37031</string>
    <string name="wizard_install_watch_code_label">Pairing code (leave empty if none)</string>
    <string name="wizard_install_watch_code_placeholder">123456</string>
    <string name="wizard_install_watch_pairing_note">This is Wireless debugging pairing for the watch — not the KeepStraight phone QR.</string>
    <string name="wizard_install_on_device">Install on %1$s</string>

