<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launcher mark (shared with desktop tray); UI chrome uses Compose One UI palette. -->
    <color name="ic_launcher_background">#2E7D6F</color>
    <color name="keepstraight_background">#F6F6F6</color>
    <color name="keepstraight_primary">#0381FE</color>
    <style name="Theme.KeepStraight" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/keepstraight_background</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowBackground">@color/keepstraight_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
