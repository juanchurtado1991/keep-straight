    <string name="app_name">Keep Straight</string>

    <!-- Onboarding -->
    <string name="onboarding_welcome_title">Welcome to Keep Straight</string>
    <string name="onboarding_welcome_body">KeepStraight watches your posture with your computer\'s webcam. This phone shows your desk time and can pass alerts to a watch.</string>
    <string name="onboarding_pair_title">Pair your watch (optional)</string>
    <string name="onboarding_pair_body">KeepStraight works with one watch. Connect it via Bluetooth, then select it below — or skip and add it later in Settings.</string>
    <string name="onboarding_pair_refresh">Refresh</string>
    <string name="onboarding_pair_bluetooth">Open Bluetooth settings</string>
    <string name="onboarding_pair_wear_companion">Open Wear companion</string>
    <string name="onboarding_pair_searching">Searching for watches…</string>
    <string name="onboarding_pair_timeout">Timed out looking for watches. Check Bluetooth, open Wear companion, then tap Refresh.</string>
    <string name="onboarding_pair_failed">Could not reach Wear OS. Check Google Play services and Bluetooth, then tap Refresh.</string>
    <string name="onboarding_pair_none">No watches found. Open Bluetooth settings or Wear companion, then tap Refresh.</string>
    <string name="onboarding_pair_multi">More than one watch is connected. KeepStraight uses one watch — pick the one you wear.</string>
    <string name="onboarding_pair_skip">Skip — no watch for now</string>
    <string name="onboarding_pair_optional">The watch is optional. Posture is detected by the desktop app; the watch only adds vibration alerts.</string>
    <string name="onboarding_pair_done">Done</string>
    <string name="onboarding_notifications_title">Enable notifications</string>
    <string name="onboarding_notifications_body">Allow notifications so Keep Straight can alert you on your phone when you slump.</string>
    <string name="onboarding_notifications_open">Open notification settings</string>
    <string name="onboarding_battery_title">Battery optimization</string>
    <string name="onboarding_battery_body">Allow unrestricted battery so background sync with your watch stays reliable.</string>
    <string name="onboarding_battery_open">Allow unrestricted battery</string>
    <string name="onboarding_battery_fallback">Open battery settings</string>
    <string name="onboarding_battery_ack">I\'ve allowed unrestricted battery</string>
    <string name="onboarding_watch_permissions_title">Watch permissions</string>
    <string name="onboarding_watch_permissions_body">Open Keep Straight on your watch and allow Body sensors, Physical activity, and the ongoing monitoring notification when prompted. These are required for posture detection.</string>
    <string name="onboarding_calibrate_title">Calibrate on your computer</string>
    <string name="onboarding_calibrate_body">Posture is measured by the KeepStraight desktop app and your webcam — not the watch. On your PC: Calibrate erect, then slumped, then Start. Pair this phone under Settings → Desktop companion so alerts reach your watch.</string>
    <string name="onboarding_calibrate_required">Open the desktop app to calibrate when you are at your computer.</string>
    <string name="onboarding_calibrate_done">You can calibrate later on your computer.</string>
    <string name="onboarding_calibrate_again">Recalibrate</string>
    <string name="onboarding_calibrate_skip">Skip for now</string>
    <string name="onboarding_sensitivity_title">Choose sensitivity</string>
    <string name="onboarding_sensitivity_body">How strictly should Keep Straight treat slumping? You can change this later.</string>
    <string name="onboarding_next">Next</string>
    <string name="onboarding_finish">Get started</string>
    <string name="onboarding_back">Back</string>

