    <string name="app_name">Keep Straight</string>

    
    <string name="onboarding_welcome_title">Bienvenido a Keep Straight</string>
    <string name="onboarding_welcome_body">KeepStraight vigila tu postura con la webcam de tu computadora. Este teléfono muestra tu tiempo en el escritorio y puede pasar alertas a un reloj.</string>
    <string name="onboarding_pair_title">Empareja tu reloj (opcional)</string>
    <string name="onboarding_pair_body">KeepStraight funciona con un reloj. Conéctalo por Bluetooth y selecciónalo abajo — o omítelo y añádelo después en Ajustes.</string>
    <string name="onboarding_pair_refresh">Actualizar</string>
    <string name="onboarding_pair_bluetooth">Abrir ajustes de Bluetooth</string>
    <string name="onboarding_pair_wear_companion">Abrir compañero Wear</string>
    <string name="onboarding_pair_searching">Buscando relojes…</string>
    <string name="onboarding_pair_timeout">Tiempo agotado buscando relojes. Comprueba Bluetooth, abre el compañero Wear y pulsa Actualizar.</string>
    <string name="onboarding_pair_failed">No se pudo contactar Wear OS. Comprueba Google Play services y Bluetooth, luego pulsa Actualizar.</string>
    <string name="onboarding_pair_none">No se encontraron relojes. Abre ajustes de Bluetooth o el compañero Wear, luego pulsa Actualizar.</string>
    <string name="onboarding_pair_multi">Hay más de un reloj conectado. KeepStraight usa uno — elige el que llevas puesto.</string>
    <string name="onboarding_pair_skip">Omitir — sin reloj por ahora</string>
    <string name="onboarding_pair_optional">El reloj es opcional. La postura la detecta la app de escritorio; el reloj solo añade vibración.</string>
    <string name="onboarding_pair_done">Listo</string>
    <string name="onboarding_notifications_title">Activar notificaciones</string>
    <string name="onboarding_notifications_body">Permite notificaciones para que Keep Straight te avise en el teléfono cuando te encorves.</string>
    <string name="onboarding_notifications_open">Abrir ajustes de notificaciones</string>
    <string name="onboarding_battery_title">Optimización de batería</string>
    <string name="onboarding_battery_body">Permite batería sin restricciones para que la sync en segundo plano con tu reloj sea fiable.</string>
    <string name="onboarding_battery_open">Permitir batería sin restricciones</string>
    <string name="onboarding_battery_fallback">Abrir ajustes de batería</string>
    <string name="onboarding_battery_ack">He permitido batería sin restricciones</string>
    <string name="onboarding_watch_permissions_title">Permisos del reloj</string>
    <string name="onboarding_watch_permissions_body">Abre Keep Straight en tu reloj y permite Sensores corporales, Actividad física y la notificación de vigilancia cuando se pida. Son necesarios para detectar postura.</string>
    <string name="onboarding_calibrate_title">Calibra en tu computadora</string>
    <string name="onboarding_calibrate_body">La postura la mide la app KeepStraight de escritorio y tu webcam — no el reloj. En tu PC: Calibra erguida, luego encorvada, luego Iniciar. Empareja este teléfono en Ajustes → Compañero de escritorio para que las alertas lleguen al reloj.</string>
    <string name="onboarding_calibrate_required">Abre la app de escritorio para calibrar cuando estés en tu computadora.</string>
    <string name="onboarding_calibrate_done">Puedes calibrar más tarde en tu computadora.</string>
    <string name="onboarding_calibrate_again">Recalibrar</string>
    <string name="onboarding_calibrate_skip">Omitir por ahora</string>
    <string name="onboarding_sensitivity_title">Elige la sensibilidad</string>
    <string name="onboarding_sensitivity_body">¿Qué tan estricto debe ser Keep Straight con la mala postura? Puedes cambiarlo después.</string>
    <string name="onboarding_next">Siguiente</string>
    <string name="onboarding_finish">Empezar</string>
    <string name="onboarding_back">Atrás</string>

    
